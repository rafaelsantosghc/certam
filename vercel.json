{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/sync",
      "destination": "/api/sync.js"
    },
    {
      "source": "/admin(.*)",
      "destination": "/index.html?admin=1"
    },
    {
      "source": "/lote(.*)",
      "destination": "/index.html?tab=lote"
    },
    {
      "source": "/concurso(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/politica(.*)",
      "destination": "/index.html?tab=politica"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
